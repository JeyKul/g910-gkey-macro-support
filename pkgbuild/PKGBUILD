pkgname=g910-gkeys-git
pkgver=0.4.2
pkgrel=3
pkgdesc='GKey support for Logitech keyboards on GNU/Linux'
arch=('any')
url='https://github.com/JeyKul/g910-gkey-macro-support'
license=('GPL-3.0-or-later')
depends=('python' 'python-pyusb' 'python-uinput' 'libusb')
optdepends=('pyside6: G910 Control graphical configurator and tray icon')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
provides=('g910-gkeys')
conflicts=('g910-gkeys')
backup=('etc/g910-gkeys/config.json')
source=('g910-source::git+https://github.com/JeyKul/g910-gkey-macro-support.git#branch=dev')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/g910-source"
  printf '0.4.2.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/g910-source"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/g910-source"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 etc/config.json "$pkgdir/etc/g910-gkeys/config.json"
  install -Dm644 etc/g910-gkeys.service "$pkgdir/usr/lib/systemd/user/g910-gkeys.service"
  sed -i 's|ExecStart=/usr/bin/env g910-gkeys|ExecStart=/usr/bin/g910-gkeys|' "$pkgdir/usr/lib/systemd/user/g910-gkeys.service"
  install -Dm644 etc/60-g910-gkeys.rules "$pkgdir/usr/lib/udev/rules.d/60-g910-gkeys.rules"
  install -Dm644 etc/uinput-g910-gkeys.conf "$pkgdir/usr/lib/modules-load.d/uinput-g910-gkeys.conf"
  install -Dm644 etc/io.github.JeyKul.G910Control.desktop "$pkgdir/usr/share/applications/io.github.JeyKul.G910Control.desktop"
  install -Dm644 etc/io.github.JeyKul.G910Control.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.JeyKul.G910Control.svg"
}
